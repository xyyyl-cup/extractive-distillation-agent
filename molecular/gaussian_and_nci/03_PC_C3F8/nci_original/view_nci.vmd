set nci_dir [file dirname [file normalize [info script]]]
display projection Orthographic
display depthcue off
display rendermode GLSL
axes location Off
color Display Background white

mol new [file join $nci_dir func1.cub] type cube waitfor all
mol addfile [file join $nci_dir func2.cub] type cube waitfor all
mol delrep 0 top

mol representation CPK 1.0 0.28 18.0 16.0
mol color Name
mol addrep top

mol representation Isosurface 0.50000 1 0 0 1 1
mol color Volume 0
mol addrep top
mol scaleminmax top 1 -0.035 0.020
color scale method BGR

display resetview
rotate x by -18
rotate y by 36
rotate z by -8
scale by 1.90


integrator=md
nsteps=2000000
dt=0.001
nstxout-compressed=5000
continuation=yes
cutoff-scheme=Verlet
coulombtype=PME
tcoupl=V-rescale
tc-grps=System
tau_t=0.1
ref_t=298.15
pcoupl=Berendsen
pcoupltype=isotropic
tau_p=2.0
ref_p=1.0
compressibility=4.5e-5
constraints=h-bonds
lincs-order=8
lincs-iter=2
